APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=some_user
DB_PASSWORD=secret_password
DB_NAME=mentor

DB_SSL_MODE=disable
DB_MAX_CONNS=20

#openssl rand -hex 32
JWT_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_ISSUER=mentor-backend

CODE_EXPIRES_IN=10m
CODE_RESEND_AFTER=1m
CODE_MAX_ATTEMPTS=3

#openssl rand -hex 32
OTP_SECRET=change_me

REFRESH_TTL=24h
REFRESH_REMEMBER_TTL=720h

# Документы для верификации наставников: папка на диске и адрес, по которому их видит фронтенд.
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=http://127.0.0.1:8080/uploads
